# Copy to .env.local for `npm run dev`; set the same names in Vercel -> Project -> Settings -> Environment Variables.

# --- Intake (submit.html -> pull request) and the wall: required
# Fine-grained personal access token for the repository, permissions:
#   Contents: Read and write · Pull requests: Read and write · Issues: Read and write
GITHUB_TOKEN=
GITHUB_REPO=ZearoGon/Draft_UEBS-Stats-Group_web
GITHUB_BASE_BRANCH=main

# --- Email extraction on the submit page (optional; the form has a built-in reader without it)
ANTHROPIC_API_KEY=
# PARSE_MODEL=claude-opus-5

# --- Gates (optional). If set, the form / the wall ask for the phrase (share it in the welcome email).
INTAKE_PASSPHRASE=
WALL_PASSPHRASE=

# --- Salt for the daily-rotating address hash used only for rate limiting (any random string)
RATE_SALT=
